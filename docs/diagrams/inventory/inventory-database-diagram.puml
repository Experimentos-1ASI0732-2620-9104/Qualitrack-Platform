@startuml inventory-database-diagram
title QualiTrack - Inventory Database Diagram

skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
hide stereotypes

package "Inventory Context" {
  entity "inventory_materials" as inventory_materials {
    * <u>id</u> : BIGINT PK AUTO_INCREMENT
    --
    laboratory_id : BIGINT NOT NULL
    environment_id : BIGINT NULL
    legacy_id : BIGINT NULL
    code : VARCHAR(50) NOT NULL
    name : VARCHAR(150) NOT NULL
    unit : VARCHAR(20) NOT NULL
    minimum_stock : DECIMAL(19,3) NOT NULL
    created_at : DATETIME(6) NOT NULL
    updated_at : DATETIME(6) NOT NULL
    --
    UNIQUE (laboratory_id, code)
    UNIQUE (laboratory_id, legacy_id)
  }
  entity "inventory_receipts" as inventory_receipts {
    * <u>id</u> : BIGINT PK AUTO_INCREMENT
    --
    laboratory_id : BIGINT NOT NULL
    material_id : BIGINT NOT NULL
    supplier : VARCHAR(150) NOT NULL
    batch_number : VARCHAR(50) NOT NULL
    unit : VARCHAR(20) NOT NULL
    initial_amount : DECIMAL(19,3) NOT NULL
    available_amount : DECIMAL(19,3) NOT NULL
    received_on : DATE NOT NULL
    expires_on : DATE NOT NULL
    status : VARCHAR(20) NOT NULL
    container_monitor_id : BIGINT NULL
    container_environment_id : BIGINT NULL
    container_assigned_by : BIGINT NULL
    container_assigned_at : DATETIME(6) NULL
    created_at : DATETIME(6) NOT NULL
    updated_at : DATETIME(6) NOT NULL
    --
    UNIQUE (laboratory_id, material_id, supplier, batch_number)
  }
  entity "inventory_movements" as inventory_movements {
    * <u>id</u> : BIGINT PK AUTO_INCREMENT
    --
    laboratory_id : BIGINT NOT NULL
    material_id : BIGINT NOT NULL
    receipt_id : BIGINT NOT NULL
    product_batch_id : BIGINT NULL
    type : VARCHAR(20) NOT NULL
    amount : DECIMAL(19,3) NOT NULL
    unit : VARCHAR(20) NOT NULL
    stock_before : DECIMAL(19,3) NOT NULL
    stock_after : DECIMAL(19,3) NOT NULL
    status_before : VARCHAR(20) NULL
    status_after : VARCHAR(20) NOT NULL
    reason : VARCHAR(500) NOT NULL
    actor_id : BIGINT NOT NULL
    occurred_at : DATETIME(6) NOT NULL
    operation_id : VARCHAR(100) NULL
    created_at : DATETIME(6) NOT NULL
    updated_at : DATETIME(6) NOT NULL
    --
    UNIQUE (laboratory_id, operation_id)
  }
}

inventory_materials ||..o{ inventory_receipts : material_id
inventory_materials ||..o{ inventory_movements : material_id
inventory_receipts ||..o{ inventory_movements : receipt_id

package "Laboratory Context (reference)" {
  entity "laboratories" as laboratories {
    * id : BIGINT PK
  }
  entity "raw_materials" as raw_materials {
    * id : BIGINT PK
    laboratory_id : BIGINT
    quantity_in_stock : DECIMAL(19,3)
    minimum_stock : DECIMAL(19,3)
  }
}
package "Equipment Context (reference)" {
  entity "equipment" as equipment {
    * id : BIGINT PK
    environment_id : BIGINT
    device_type : VARCHAR
    status : VARCHAR
  }
}
package "IAM Context (reference)" {
  entity "iam_users" as iam_users {
    * id : BIGINT PK
  }
}
package "Batch Context" {
  entity "batches" as batches {
    * id : BIGINT PK
    laboratory_id : BIGINT
  }
entity "raw_material_usages" as raw_material_usages {
  * <u>id</u> : BIGINT PK AUTO_INCREMENT
  --
  batch_id : BIGINT NOT NULL
  raw_material_id : BIGINT NOT NULL
  inventory_receipt_id : BIGINT NULL
  raw_material_name : VARCHAR(150) NOT NULL
  quantity_used : DOUBLE NOT NULL
  unit : VARCHAR(20) NOT NULL
  usage_date : VARCHAR(30) NOT NULL
  stock_before : DECIMAL(19,3) NULL
  stock_after : DECIMAL(19,3) NULL
  created_at : DATETIME(6) NOT NULL
  updated_at : DATETIME(6) NOT NULL
}
}
batches ||..o{ raw_material_usages : batch_id
laboratories ||..o{ inventory_materials : laboratory_id
laboratories ||..o{ inventory_receipts : laboratory_id
laboratories ||..o{ inventory_movements : laboratory_id
raw_materials |o..o| inventory_materials : legacy_id / explicit import
batches |o..o{ inventory_movements : product_batch_id
iam_users ||..o{ inventory_movements : actor_id
inventory_receipts |o..o{ raw_material_usages : inventory_receipt_id
equipment |o..o{ inventory_receipts : container_monitor_id
iam_users |o..o{ inventory_receipts : container_assigned_by

note bottom of inventory_materials
  Catalogue only: usableStock and physicalStock are calculated,
  not stored columns. Legacy records remain in raw_materials.
end note
note bottom of inventory_receipts
  QUARANTINED / RELEASED / OBSERVED / REJECTED.
  Available stock belongs to each supplier receipt.
  Units must match the catalogue; no implicit conversion.
  container_* columns: container monitor (CONTAINER_MONITOR equipment) where the lot
  is stored and its RAW_MATERIAL_STORAGE environment; NULL while it has none.
end note
note bottom of inventory_movements
  Append-only application history; signed amount.
  operation_id is populated for consumptions (idempotent retries).
  Receipt, movement and Batch usage share one transaction.
  occurred_at is mapped from Instant (UTC).
end note
note bottom of raw_material_usages
  inventory_receipt_id is NULL for legacy usage.
  With a receipt, raw_material_id identifies inventory_materials;
  otherwise it identifies legacy raw_materials.
  stock_before / stock_after may be NULL for historical records.
end note
legend bottom
  Inventory and Batch references drawn with dotted lines are logical ID links.
  Current JPA mappings use scalar IDs, not declared foreign-key associations.
  Columns and unique constraints are based on the source mappings, not a live DB export.
endlegend

@enduml
