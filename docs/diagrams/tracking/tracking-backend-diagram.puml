package "tracking.domain.repositories" {
  interface EnvironmentalProfileRepository {
    + save(profile: EnvironmentalProfile): EnvironmentalProfile
    + findByEnvironmentId(environmentId: Long): Optional<EnvironmentalProfile>
    + findByDeviceId(deviceId: Long): Optional<EnvironmentalProfile>
  }

  interface MeasurementRepository {
    + save(measurement: Measurement): Measurement
    + findByDeviceAndPeriod(deviceId, metric, from, to): List<Measurement>
    + findByDeviceAndMetricAndMeasuredAt(deviceId, metric, measuredAt): Optional<Measurement>
    + findPreviousReading(deviceId, metric, before): Optional<Measurement>
    + findByEnvironmentAndPeriod(laboratoryId, environmentId, from, to): List<Measurement>
    + findLastReceivedAt(deviceId: Long): Optional<Instant>
  }

  interface ActuationEventRepository {
    + save(event: ActuationEvent): ActuationEvent
    + findByDeviceAndPeriod(deviceId, from, to): List<ActuationEvent>
    + findByDeviceAndActionAndOccurredAt(deviceId, action, occurredAt): Optional<ActuationEvent>
    + findByEnvironmentAndPeriod(laboratoryId, environmentId, from, to): List<ActuationEvent>
    + findLastReceivedAt(deviceId: Long): Optional<Instant>
  }
}

EnvironmentalProfileRepository --> EnvironmentalProfile
MeasurementRepository --> Measurement
ActuationEventRepository --> ActuationEvent

package "tracking.application.commandservices" {
  interface TrackingCommandService {
    + handle(command: UpdateEnvironmentThresholdsCommand): Result<EnvironmentalProfile, ApplicationError>
    + handle(command: UpdateContainerMonitorThresholdsCommand): Result<EnvironmentalProfile, ApplicationError>
    + handle(command: UpdateActuationRulesCommand): Result<EnvironmentalProfile, ApplicationError>
    + handle(command: RecordMeasurementCommand): Result<Recorded<Measurement>, ApplicationError>
    + handle(command: RecordActuationEventCommand): Result<Recorded<ActuationEvent>, ApplicationError>
  }

  class Recorded <<record>> {
    + value: T
    + created: boolean
  }
}

TrackingCommandService ..> Result
TrackingCommandService ..> ApplicationError
TrackingCommandService +-- Recorded
note bottom of Recorded
  created = false when the same reading or action
  (device, metric/action, moment) was already received.
end note

package "tracking.application.queryservices" {
