    + handle(query: GetEnvironmentProfileQuery): Optional<EnvironmentalProfile>
    + handle(query: GetContainerMonitorProfileQuery): Optional<EnvironmentalProfile>
    + handle(query: GetDeviceProfileQuery): Optional<EnvironmentalProfile>
    + handle(query: GetMeasurementsQuery): Optional<List<Measurement>>
    + handle(query: GetActuationEventsQuery): Optional<List<ActuationEvent>>
    + handle(query: GetDeviceConnectionQuery): Optional<DeviceConnection>
  }
}

