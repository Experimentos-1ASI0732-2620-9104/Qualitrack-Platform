  class TrackingCommandServiceImpl
}

TrackingCommandServiceImpl ..|> TrackingCommandService
TrackingCommandServiceImpl --> EnvironmentalProfileRepository
TrackingCommandServiceImpl --> MeasurementRepository
TrackingCommandServiceImpl --> ActuationEventRepository
TrackingCommandServiceImpl --> ApplicationEventPublisher
TrackingCommandServiceImpl --> Clock
TrackingCommandServiceImpl ..> MeasurementRecordedEvent
TrackingCommandServiceImpl ..> EnvironmentalDeviationDetectedEvent
TrackingCommandServiceImpl ..> EnvironmentalConditionNormalizedEvent : WARNING/CRITICAL -> NORMAL
TrackingCommandServiceImpl ..> EnvironmentalProfileUpdatedEvent
note right of TrackingCommandServiceImpl
  The device must be located in the environment and report the metric.
  A reading more than 5 minutes in the future is rejected (400).
  The reading is evaluated with the profile in force; a deviation event is
  published only when the state worsens against the previous reading
  (NORMAL -> WARNING -> CRITICAL), so a sustained deviation is alerted once.
end note

package "tracking.application.internal.queryservices" {
  class TrackingQueryServiceImpl
}

TrackingQueryServiceImpl ..|> TrackingQueryService
TrackingQueryServiceImpl --> EnvironmentalProfileRepository
TrackingQueryServiceImpl --> MeasurementRepository
TrackingQueryServiceImpl --> ActuationEventRepository
TrackingQueryServiceImpl --> ExpectedCommunicationPeriod
TrackingQueryServiceImpl ..> DeviceConnection
note right of TrackingQueryServiceImpl
  Last communication = latest reading or action received,
  compared with the expected period
  (tracking.devices.expected-communication-period, PT5M).
end note

